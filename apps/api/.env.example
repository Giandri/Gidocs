# Server
PORT=8080

# Upload limits
MAX_UPLOAD_MB=50
MAX_FILES=20
REQUEST_TIMEOUT=120s

# CORS (comma-separated origins, empty = allow all)
CORS_ALLOWED_ORIGINS=

# Ghostscript untuk Compress (kosongkan: default gswin64c di Windows, gs di Linux)
# GS_BIN=gswin64c

# Redis untuk antrian jobs (asynq) - dipakai API dan cmd/worker
REDIS_ADDR=localhost:6379

# LibreOffice untuk DOCX/Excel/PPTX to PDF (kosongkan: cari otomatis di PATH)
# SOFFICE_BIN=C:/Program Files/LibreOffice/program/soffice.com